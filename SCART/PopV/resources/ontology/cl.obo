subset: pheno_slim
subset: uberon_slim
subset: vertebrate_core
synonym: "cranial nerves" RELATED []
synonym: "cranial neural tree organ" EXACT []
synonym: "nervus cranialis" RELATED LATIN [Wikipedia:Cranial_nerve]
