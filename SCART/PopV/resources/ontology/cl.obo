id: UBERON:0004637
name: otic capsule
namespace: uberon
def: "The capsule surrounding the inner ear mechanism." [http://www.biology-online.org/dictionary/Otic_capsule]
synonym: "auditory capsule" RELATED [VHOG:0000854]
synonym: "otic capsule" EXACT [ZFA:0001500]
synonym: "otic capsule element" EXACT [https://github.com/obophenotype/uberon/wiki/Modeling-endochondral-elements-Design-Pattern]
synonym: "otic capsule endochondral element" EXACT [https://github.com/obophenotype/uberon/wiki/Modeling-endochondral-elements-Design-Pattern]
