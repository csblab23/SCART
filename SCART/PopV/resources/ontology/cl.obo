subset: attribute_slim
is_a: PATO:0000068 ! qualitative

[Term]
id: PATO:0000117
name: size
namespace: quality
def: "A morphology quality inhering in a bearer by virtue of the bearer's physical magnitude." [WordNet:WordNet]
subset: attribute_slim
subset: scalar_slim
is_a: PATO:0000051 ! morphology

[Term]
id: PATO:0000125
