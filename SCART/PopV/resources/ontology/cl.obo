[Term]
id: UBERON:0001813
name: spinal nerve plexus
namespace: uberon
def: "An intermingling of fiber fascicles from adjacent spinal nerves to form a network." [http://www.medilexicon.com/medicaldictionary.php?t=70024]
synonym: "plexus nervorum spinalium" EXACT LATIN [FMA:5903, FMA:TA]
synonym: "plexus of spinal nerves" EXACT [FMA:5903]
synonym: "somatic nerve plexus" EXACT [FMA:5903]
synonym: "spinal nerve plexus" EXACT [FMA:5903]
