[Term]
id: UBERON:0005270
name: renal cortex interstitium
namespace: uberon
def: "A compartment of the renal cortex situated between basement membranes of epithelia and vessels that contains two contiguous cellular networks in mutual contact, one formed by interstitial fibroblasts, the other by dendritic cells." [PMID:18575881]
synonym: "cortical stroma" RELATED [EMAPA:28136]
synonym: "kidney cortex interstitium" EXACT [MA:0002608]
synonym: "renal cortical interstitial tissue" EXACT []
xref: EMAPA:28136
