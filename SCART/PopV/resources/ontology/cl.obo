[Term]
id: UBERON:0003946
name: placenta labyrinth
namespace: uberon
def: "The placental layers where embryonic blood vessels are surrounded by trophoblast cells and maternal blood." [MP:0001716]
subset: pheno_slim
synonym: "labyrinthine layer" EXACT [GO:0060713]
synonym: "labyrinthine layer of placenta" EXACT [GO:0060713]
synonym: "placental labyrinth" EXACT []
