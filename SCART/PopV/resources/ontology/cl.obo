[Term]
id: UBERON:0006858
name: adrenal/interrenal gland
namespace: uberon
def: "This gland can either be a discrete structure located bilaterally above each kidney, or a cluster of cells in the head kidney that perform the functions of the adrenal gland. In either case, this organ consists of two cells types, aminergic chromaffin cells and steroidogenic cortical cells[GO]." [GO:0030325]
subset: homology_grouping
subset: organ_slim
synonym: "adrenal - interrenal gland" RELATED [VHOG:0001141]
synonym: "adrenal gland - interrenal gland" EXACT [VHOG:0001141]
synonym: "adrenal gland/interrenal tissue" EXACT []
synonym: "suprarenal gland - interrenal gland" RELATED [VHOG:0001141]
