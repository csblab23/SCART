property_value: UBPROP:0000001 "Swellings of tissue present between the endocardial and myocardial cell layers that will give rise to the interstitial cells of the cardiac valves.[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0001317", ontology="TAO", source="ZFIN:curator"}
