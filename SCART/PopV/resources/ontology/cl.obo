synonym: "eosinophilic erythroblast" EXACT [ISBN:0721601464]
synonym: "late erythoblast" EXACT []
synonym: "orthochromatic normoblast" EXACT [ISBN:0721601464]
synonym: "pyknotic eto enrythroblast" EXACT [ISBN:0721601464]
